void solve(){
    int n , m;
    cin >> n >> m;
    vll v(n+1);
    rep(i,n)cin >> v[i+1];

    vector<vector<int>>adj(n+1);
    rep(i,m){
        int a,b;
        cin >>a >> b;
        adj[a].pb(b);
        adj[b].pb(a);
    }


    ll tot = 0;
    vi visited(n+1,0);
    for (int i=1;i<=n;i++){
        // implement bfs to find the minimum cost for that connected component

        if (visited[i]!=1){
            queue<int>q;
            q.push(i);
            visited[i] = 1;
            ll mini = inf;
            while(!q.empty()){
                int node = q.front();
                q.pop();
                mini = min(mini , v[node]);
                for (auto neighbor:adj[node]){
                    if (visited[neighbor]!=1){
                        visited[neighbor]=1;
                        q.push(neighbor);
                    }
                }
            }

            tot += mini;
        }
        


    }


    for (int i=1;i<=n;i++){
        if (visited[i] == 0){
            tot += v[i];
        }
    }

    cout << tot <<"\n";

    


}
