void solve(){
    

    int n,m;
    cin >> n>>m;
    vi v(n);
    rep(i,n)cin >> v[i];

    string x;
    cin >> x;
    int l=0,r=n-1;
    vi order;
    rep(i,n){
        if(x[i]=='L'){
            order.pb(l);
            l++;
        }
        else{
            order.pb(r);
            r--;
        }
    }

    vll ans;

    ll curr = 1;

    for (int i=n-1;i>=0;--i){
        curr = (curr*v[order[i]])%m;
        ans.pb(curr);
    }

    reverse(all(ans));
    rep(i,n){
        cout << ans[i] <<" ";
    }
    cout << "\n";

}
