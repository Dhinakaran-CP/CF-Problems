void solve(){

    string x; cin >> x;
    int n = x.size();
    map<int, int> mp;
    for (char c : x) {
        mp[c - '0']++;
    }

    if (n == 1) {
        if (x == "8") cout << "Yes\n";
        else cout << "No\n";
        return;
    }

    if (n == 2) {
        int val1 = (x[0] - '0') * 10 + (x[1] - '0');
        int val2 = (x[1] - '0') * 10 + (x[0] - '0');
        if (val1 % 8 == 0 || val2 % 8 == 0) {
            cout << "Yes\n";
        } else {
            cout << "No\n";
        }
        return;
    }

    vector<map<int, int>> v;
    for (int i = 104; i < 1000; i += 8) {
        if (i % 10 == 0) continue; // Skip since '0' is not in the input digits 1-9
        
        int num = i;
        map<int, int> temp;
        while (num > 0) {
            temp[num % 10]++;
            num /= 10;
        }
        v.pb(temp);
    }


    bool ok = false;
    for (auto m : v) {
        bool found = true;
        for (auto i : m) {
            if (mp[i.first] >= i.second) {
                continue;
            } else {
                found = false;
                break;
            }
        }
        if (found) {
            ok = true;
            break;
        }
    }

    if (ok) cout << "Yes\n";
    else cout << "No\n";



}

int32_t main() {
    ios_base::sync_with_stdio(0);
    cin.tie(0);
    int t = 1;
    //cin >> t;

    while(t--){
        solve();
    }
    return 0;
}
