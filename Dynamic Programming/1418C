int points(int n , vi &a){
        vector<vector<int>>dp(n+1,vi(2,inf));

        dp[0][0] = 0;
        rep(i,n){
                if(dp[i][0]!=inf){
                        if (i+1<=n){
                                dp[i+1][1] = min(dp[i+1][1],dp[i][0]+a[i]);
                        }
                        if (i+2<=n){
                                dp[i+2][1] = min(dp[i+2][1],dp[i][0] + a[i]+a[i+1]);
                        }
                }

                if (dp[i][1] != inf){
                        if (i+1<=n)dp[i+1][0] = min(dp[i+1][0],dp[i][1]);
                        if (i+2<=n)dp[i+2][0] = min(dp[i+2][0],dp[i][1]);
                }
        }


        return min(dp[n][0] , dp[n][1]);
}
