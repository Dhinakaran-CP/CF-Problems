void solve(){

        int n,m;
        cin >> n >> m;
        vector<vi>grid(n,vi(m));
        rep(i,n){
                rep(j,m){
                        cin >> grid[i][j];
                }
        }

        if ((n+m-1)%2!=0){
                cout << "NO\n";
                return;
        }

        vector<vi>mn(n,vi(m)),mx(n,vi(m));

        rep(i,n){
                rep(j,m){
                        if (i==0 && j==0){
                                mn[i][j] = mx[i][j] = grid[i][j];
                        }
                        else{
                                int low = 1e9,high = -1e9;
                                if (i>0){
                                        low = min(low , mn[i-1][j]);
                                        high = max(high,mx[i-1][j]);
                                }
                                if (j>0){
                                        low = min(low , mn[i][j-1]);
                                        high = max(high,mx[i][j-1]);
                                }


                                mn[i][j] = grid[i][j]+low;
                                mx[i][j] = grid[i][j]+high;
                        }
                }
        }

        if (mn[n-1][m-1] <=0 && mx[n-1][m-1]>=0)cout <<"YES\n";
        else cout << "NO\n";
}
